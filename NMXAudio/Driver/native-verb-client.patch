+
+extern "C" int nmx_hda_codec_verb(void *controller, uint16_t nid, uint16_t verb,
+    uint16_t param, uint32_t *response);
+
+IOReturn NMXAudio::executeCodecVerb(uint16_t nid, uint16_t verb, uint16_t param, uint32_t *response)
+{
+    IORecursiveLockLock(g_lock);
+    const int error = displayPowered_ && !displayStopping_ && dev_ ?
+        nmx_hda_codec_verb(dev_, nid, verb, param, response) : ENXIO;
+    IORecursiveLockUnlock(g_lock);
+    switch (error) {
+        case 0: return kIOReturnSuccess;
+        case EINVAL: return kIOReturnBadArgument;
+        case ENXIO: return kIOReturnNotReady;
+        case EEXIST: return kIOReturnUnsupported;
+        case ENOMEM: return kIOReturnNoMemory;
+        default: return kIOReturnIOError;
+    }
+}
+
+extern "C" IOReturn nmx_audio_native_execute_verb(void *service, uint16_t nid,
+    uint16_t verb, uint16_t param, uint32_t *response)
+{
+    auto *controller = OSDynamicCast(NMXAudio, static_cast<OSObject *>(service));
+    if (controller == nullptr || response == nullptr)
+        return kIOReturnBadArgument;
+    return controller->executeCodecVerb(nid, verb, param, response);
+}
 
